{
  "name": "basis-ng",
  "version": "0.0.0",
  "workspaces": [
    "projects/primitives",
    "projects/styles"
  ],
  "scripts": {
    "ng": "ng",
    "lint": "ng lint",
    "lint:fix": "ng lint --fix",
    "fmt": "prettier --write .",
    "clean": "npm run fmt && npm run lint:fix",
    "update:angular": "ng update @angular/core@20.2.x @angular/cli@20.2.x @angular/cdk@20.2.x",
    "watch:primitives": "ng build primitives --watch --configuration development",
    "build:primitives": "ng build primitives",
    "publish:primitives:patch": "node publish.js primitives patch",
    "publish:primitives:minor": "node publish.js primitives minor",
    "publish:primitives:major": "node publish.js primitives major",
    "publish:primitives:alpha": "node publish.js primitives prerelease alpha",
    "publish:primitives:beta": "node publish.js primitives prerelease beta",
    "publish:primitives:rc": "node publish.js primitives prerelease rc",
    "publish:styles:patch": "node publish.js styles patch",
    "publish:styles:minor": "node publish.js styles minor",
    "publish:styles:major": "node publish.js styles major",
    "publish:styles:alpha": "node publish.js styles prerelease alpha",
    "publish:styles:beta": "node publish.js styles prerelease beta",
    "publish:styles:rc": "node publish.js styles prerelease rc",
    "serve:docs": "ng serve docs",
    "build:docs": "ng build docs",
    "watch:docs": "ng build docs --watch",
    "deploy:docs": "npm run fmt && npm run lint && vercel --prod"
  },
  "private": true,
  "engines": {
    "node": ">=20.19.0 || >=22.12.0"
  },
  "dependencies": {
    "@angular/cdk": "^20.2.0",
    "@angular/common": "^20.2.0",
    "@angular/compiler": "^20.2.0",
    "@angular/core": "^20.2.0",
    "@angular/forms": "^20.2.0",
    "@angular/platform-browser": "^20.2.0",
    "@angular/platform-browser-dynamic": "^20.2.0",
    "@angular/router": "^20.2.0",
    "@basis-ng/primitives": "^0.0.1-alpha.95",
    "@basis-ng/styles": "^0.0.1-alpha.105",
    "@ng-icons/core": "^32.1.0",
    "@ng-icons/lucide": "^32.1.0",
    "@tailwindcss/postcss": "^4.1.13",
    "ngx-highlightjs": "^14.0.0",
    "postcss": "^8.5.6",
    "rxjs": "~7.8.0",
    "tailwindcss": "^4.1.13",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^20.2.0",
    "@angular/cli": "^20.2.0",
    "@angular/compiler-cli": "^20.2.0",
    "@eslint/js": "^9.23.0",
    "@types/jasmine": "~5.1.0",
    "angular-eslint": "^20.0.0",
    "eslint": "^9.23.0",
    "eslint-config-prettier": "^10.1.1",
    "eslint-plugin-prettier": "^5.2.5",
    "eslint-plugin-unused-imports": "^4.1.4",
    "jasmine-core": "~5.6.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "ng-packagr": "^20.2.0",
    "prettier": "^3.5.3",
    "semver": "^7.6.3",
    "typescript": "~5.8.0",
    "typescript-eslint": "8.27.0"
  }
}
