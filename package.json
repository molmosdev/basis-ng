{
  "name": "basis-ng",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "lint": "ng lint",
    "lint:fix": "ng lint --fix",
    "format": "prettier --write .",
    "clean": "npm run format && npm run lint:fix",
    "serve:docs": "ng serve docs",
    "build:docs": "ng build docs",
    "build:primitives": "ng build primitives",
    "publish:primitives": "npm run publish:primitives:alpha",
    "publish:primitives:patch": "node publish.js primitives patch",
    "publish:primitives:minor": "node publish.js primitives minor",
    "publish:primitives:major": "node publish.js primitives major",
    "publish:primitives:alpha": "node publish.js primitives prerelease alpha",
    "publish:primitives:beta": "node publish.js primitives prerelease beta",
    "publish:primitives:rc": "node publish.js primitives prerelease rc",
    "publish:styles": "npm run publish:styles:alpha",
    "publish:styles:patch": "node publish.js styles patch",
    "publish:styles:minor": "node publish.js styles minor",
    "publish:styles:major": "node publish.js styles major",
    "publish:styles:alpha": "node publish.js styles prerelease alpha",
    "publish:styles:beta": "node publish.js styles prerelease beta",
    "publish:styles:rc": "node publish.js styles prerelease rc"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "dependencies": {
    "@angular/aria": "^21.0.6",
    "@angular/cdk": "^21.0.6",
    "@angular/common": "^21.0.8",
    "@angular/compiler": "^21.0.8",
    "@angular/core": "^21.0.8",
    "@angular/forms": "^21.0.8",
    "@angular/platform-browser": "^21.0.8",
    "@angular/platform-server": "^21.0.8",
    "@angular/router": "^21.0.8",
    "@basis-ng/primitives": "^0.0.1-alpha.138",
    "@basis-ng/styles": "^0.0.1-alpha.182",
    "@ng-icons/core": "^32.2.0",
    "@ng-icons/lucide": "^32.2.0",
    "@tailwindcss/postcss": "^4.1.13",
    "ngx-highlightjs": "^14.0.0",
    "postcss": "^8.5.6",
    "rxjs": "~7.8.0",
    "tailwindcss": "^4.1.13",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.0.5",
    "@angular/cli": "^21.0.5",
    "@angular/compiler-cli": "^21.0.8",
    "angular-eslint": "21.1.0",
    "eslint": "^9.37.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "ng-packagr": "^21.0.0",
    "postcss": "^8.5.3",
    "prettier": "^3.6.2",
    "typescript": "~5.9.2",
    "typescript-eslint": "8.46.0"
  }
}
